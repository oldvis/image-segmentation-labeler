    "konva": "^10.3.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "uuid": "^14.0.1",
    "vue": "^3.5.40",
    "vue-konva": "^3.4.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@iconify-json/fa6-brands": "^1.2.6",
